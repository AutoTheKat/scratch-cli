    "@onirenaud/node-webgl": "^0.2.0",
    "@turbowarp/scaffolding": "^0.4.0",
    "canvas": "^3.2.3",
    "ink": "^8.0.0",
    "ink-picture": "^2.1.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "sixel": "^0.16.0",
    "svgdom": "^0.1.29",
